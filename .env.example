# Environment setting for app name.
APP_NAME="School Manager"
# Environment setting for app env.
APP_ENV=local
# Environment setting for app key.
APP_KEY=
# Environment setting for app debug.
APP_DEBUG=true
# Environment setting for app url.
APP_URL=http://127.0.0.1:8000

# Environment setting for log channel.
LOG_CHANNEL=stack
# Environment setting for log level.
LOG_LEVEL=debug

# Environment setting for db connection.
DB_CONNECTION=mysql
# Environment setting for db host.
DB_HOST=127.0.0.1
# Environment setting for db port.
DB_PORT=3306
# Environment setting for db database.
DB_DATABASE=schoolmanager
# Environment setting for db username.
DB_USERNAME=root
# Environment setting for db password.
DB_PASSWORD=
# For Aiven/managed MySQL, set this to the CA certificate path when required.
# Environment setting for mysql attr ssl ca.
MYSQL_ATTR_SSL_CA=

# Environment setting for session driver.
SESSION_DRIVER=database
# Environment setting for cache store.
CACHE_STORE=database
# Environment setting for queue connection.
QUEUE_CONNECTION=database

# Public school media storage.
# FREE LOCAL DEVELOPMENT / PERSISTENT VPS: keep PUBLIC_DISK_DRIVER=local.
# IMPORTANT: serverless deployments such as Vercel should use a persistent
# external object store for uploads; local files can disappear when instances
# are replaced. Do not put storage credentials in Git.
# Environment setting for filesystem disk.
FILESYSTEM_DISK=public
# Environment setting for public disk driver.
PUBLIC_DISK_DRIVER=local
# Environment setting for public disk url.
PUBLIC_DISK_URL=
# Environment setting for public disk visibility.
PUBLIC_DISK_VISIBILITY=public
# Vercel's request-body limit requires small uploads through the Laravel app.
# Keep videos at or below this value; use persistent direct-upload storage for larger videos.
# Environment setting for video upload max kb.
VIDEO_UPLOAD_MAX_KB=4300
# Environment setting for aws access key id.
AWS_ACCESS_KEY_ID=
# Environment setting for aws secret access key.
AWS_SECRET_ACCESS_KEY=
# Environment setting for aws default region.
AWS_DEFAULT_REGION=us-east-1
# Environment setting for aws bucket.
AWS_BUCKET=
# Environment setting for aws url.
AWS_URL=
# Environment setting for aws endpoint.
AWS_ENDPOINT=
# Environment setting for aws use path style endpoint.
AWS_USE_PATH_STYLE_ENDPOINT=false
# Environment setting for aws visibility.
AWS_VISIBILITY=public

# Environment setting for mail mailer.
MAIL_MAILER=smtp
# Environment setting for mail host.
MAIL_HOST=your-smtp-server
# Environment setting for mail port.
MAIL_PORT=587
# Environment setting for mail username.
MAIL_USERNAME=your-email
# Environment setting for mail password.
MAIL_PASSWORD=your-password
# Environment setting for mail encryption.
MAIL_ENCRYPTION=tls
# Environment setting for mail from address.
MAIL_FROM_ADDRESS=your-email
# Environment setting for mail from name.
MAIL_FROM_NAME="School Manager"

# Safaricom Daraja M-Pesa configuration.
# MPESA_ENV selects sandbox or production; credentials must belong to that same Daraja app.
# Keep real credentials in the local/deployment .env file; never commit secrets.
# Environment setting for mpesa env.
MPESA_ENV=sandbox
# Environment setting for mpesa consumer key.
MPESA_CONSUMER_KEY=
# Environment setting for mpesa consumer secret.
MPESA_CONSUMER_SECRET=
# Environment setting for mpesa shortcode.
MPESA_SHORTCODE=
# Environment setting for mpesa passkey.
MPESA_PASSKEY=
# Environment setting for mpesa transaction type.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Must be a publicly reachable HTTPS URL in production.
# Environment setting for mpesa callback url.
MPESA_CALLBACK_URL=

# Vercel/external scheduler authentication for the protected queue endpoint.
# Generate a long random value and store it only in the hosting environment.
# Environment setting for cron secret.
CRON_SECRET=

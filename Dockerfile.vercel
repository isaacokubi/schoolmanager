FROM dunglas/frankenphp:php8.3-bookworm

WORKDIR /app

# Laravel / database / image / archive extensions.
RUN install-php-extensions \
    bcmath \
    ctype \
    curl \
    dom \
    fileinfo \
    gd \
    intl \
    mbstring \
    mysqli \
    opcache \
    pcntl \
    pdo_mysql \
    zip

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install PHP dependencies first for Docker layer caching.
COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --classmap-authoritative

# Application source.
COPY . .

# The authoritative Composer classmap was generated before the Laravel
# application source existed in the image. Regenerate it after COPY so
# App\\Http\\Kernel and all other application classes are discoverable.
RUN composer dump-autoload \
    --no-dev \
    --optimize \
    --classmap-authoritative

# Laravel runtime directories and the conventional public-media link.
# The link is useful when the public disk is local and media is packaged in
# the image (for example, seeded/demo media). Runtime uploads must still use
# persistent object storage when the app runs on Vercel.
RUN mkdir -p \
    storage/app/public/school-media \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && rm -rf public/storage \
    && ln -s ../storage/app/public public/storage

# Package one small, browser-compatible demo MP4 into the deployment image.
# This fixture is 3.4 MB, safely below the application's 4.3 MB video limit
# and leaves headroom below Vercel's 4.5 MB request-body limit for uploads.
# The upstream publishes stable download URLs and SHA256 manifests.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -L --fail --silent --show-error --retry 3 \
        -o storage/app/public/school-media/demo-school-video-3-4mb.mp4 \
        https://samplefile.com/samples/download/video/mp4/mp4_60s_sample_file_3.4MB.mp4/ \
    && test "$(stat -c%s storage/app/public/school-media/demo-school-video-3-4mb.mp4)" -lt 4300000 \
    && file storage/app/public/school-media/demo-school-video-3-4mb.mp4 | grep -Eiq 'ISO Media|MPEG-4|MP4' \
    && rm -rf /var/lib/apt/lists/*

# Allow FrankenPHP/Caddy to read the application and Laravel
# to write runtime cache/log directories and local media.
RUN chown -R www-data:www-data \
    storage \
    bootstrap/cache \
    public/storage

# Vercel supplies PORT. FrankenPHP must listen on it.
CMD ["sh", "-c", "frankenphp php-server --root=public --listen=:$PORT"]

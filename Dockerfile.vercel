FROM dunglas/frankenphp:php8.3-bookworm

WORKDIR /app

# Laravel / database / image / archive extensions.
RUN install-php-extensions \
    bcmath \
    ctype \
    curl \
    dom \
    fileinfo \
    gd \
    intl \
    mbstring \
    mysqli \
    opcache \
    pcntl \
    pdo_mysql \
    zip

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install PHP dependencies first for Docker layer caching.
COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --classmap-authoritative

# Application source.
COPY . .

# The authoritative Composer classmap was generated before the Laravel
# application source existed in the image. Regenerate it after COPY so
# App\\Http\\Kernel and all other application classes are discoverable.
RUN composer dump-autoload \
    --no-dev \
    --optimize \
    --classmap-authoritative

# Laravel runtime directories. Do NOT create public/storage as a symlink.
# /storage/{path} is an application media endpoint and must reach Laravel so
# HTTP Range requests are handled consistently instead of being intercepted
# by the web server as a static file.
RUN mkdir -p \
    storage/app/public/school-media \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && rm -rf public/storage

# Package deterministic public demo media into the deployment image. The
# filenames intentionally match the existing school_media database records.
# The old 44 MB MP4 is NOT used; this path now contains a fresh 3.4 MB MP4.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl file \
    && curl -L --fail --silent --show-error --retry 3 \
        -o storage/app/public/school-media/demo-20260917201809-3b9f556a57.jpg \
        https://samplefile.com/samples/download/image/jpeg/jpeg_1000x600_sample_file_36KB.jpeg/ \
    && curl -L --fail --silent --show-error --retry 3 \
        -o storage/app/public/school-media/demo-20260917201810-f6989e8c29.jpg \
        https://samplefile.com/samples/download/image/jpeg/jpeg_2000x1200_sample_file_72KB.jpeg/ \
    && curl -L --fail --silent --show-error --retry 3 \
        -o storage/app/public/school-media/demo-20260917201812-02fc9a8cbc.jpg \
        https://samplefile.com/samples/download/image/jpeg/jpeg_500x300_sample_file_15KB.jpeg/ \
    && curl -L --fail --silent --show-error --retry 3 \
        -o storage/app/public/school-media/demo-20260917201836-4b089bf7e9.mp4 \
        https://samplefile.com/samples/download/video/mp4/mp4_60s_sample_file_3.4MB.mp4/ \
    && file storage/app/public/school-media/demo-20260917201809-3b9f556a57.jpg | grep -Eiq 'JPEG|image' \
    && file storage/app/public/school-media/demo-20260917201810-f6989e8c29.jpg | grep -Eiq 'JPEG|image' \
    && file storage/app/public/school-media/demo-20260917201812-02fc9a8cbc.jpg | grep -Eiq 'JPEG|image' \
    && file storage/app/public/school-media/demo-20260917201836-4b089bf7e9.mp4 | grep -Eiq 'ISO Media|MPEG-4|MP4' \
    && test "$(stat -c%s storage/app/public/school-media/demo-20260917201836-4b089bf7e9.mp4)" -lt 4300000 \
    && rm -rf /var/lib/apt/lists/*

# Allow FrankenPHP/Caddy to read the application and Laravel
# to write runtime cache/log directories and local media.
RUN chown -R www-data:www-data \
    storage \
    bootstrap/cache

# Vercel supplies PORT. FrankenPHP must listen on it.
CMD ["sh", "-c", "frankenphp php-server --root=public --listen=:$PORT"]
